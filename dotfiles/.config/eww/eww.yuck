(defpoll tasks_todos :interval "60s"
  "cat ~/.cache/eww_tasks_todos.json")

(defpoll tasks_cours :interval "60s"
  "cat ~/.cache/eww_tasks_cours.json")


(defwidget todo_widget [tasks title accent]
  (box
    :class "todo ${accent}"
    :orientation "vertical"
    :space-evenly false
    :vexpand true
    :hexpand true

    (box
      :class "header"
      :orientation "horizontal"
      :space-evenly false

      (label
        :class "title"
        :halign "start"
        :hexpand true
        :text title)

      (label
        :class "count"
        :halign "end"
        :text {arraylength(tasks)}))

    (box
      :class "empty"
      :visible {arraylength(tasks) == 0}
      (label
        :halign "start"
        :text "Aucune tâche"))

    (scroll
      :vscroll true
      :hscroll false
      :vexpand true
      :visible {arraylength(tasks) > 0}

      (box
        :orientation "vertical"
        :space-evenly false

        (for task in tasks
          (box
            :class "task p-${task.priority ?: 'none'} ${task.done ? 'done' : ''}"
            :orientation "horizontal"
            :halign "fill"
            :space-evenly false
            :spacing 8

            (label
              :class "task-mark"
              :halign "start"
              :text {task.done ? "✓ " : "○ "})

            (label
              :class "task-title"
              :halign "start"
              :hexpand true
              :text {task.title})

            (label
              :class "task-due"
              :halign "end"
              :text {task.due ?: ""})))))
  )
)

(defwindow todo-tasks
        :monitor 0
        :geometry ( geometry :x "20px"
                             :y "40px"
                             :width "420px"
                             :height "40%"
                             :anchor "top left")
        :stacking "bg"
        :focusable false
        :wm-ignore false

    (todo_widget :tasks tasks_todos :title "Tâches" :accent "todos")
)

(defwindow todo-cours
        :monitor 0
        :geometry ( geometry :x "20px"
                             :y "40px"
                             :width "420px"
                             :height "40%"
                             :anchor "bottom left")
        :stacking "bg"
        :focusable false
        :wm-ignore false

    (todo_widget :tasks tasks_cours :title "Cours" :accent "cours")
)
