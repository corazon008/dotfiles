(defpoll tasks_todos :interval "60s"
  "cat ~/.cache/eww_tasks_todos.json")

(defpoll tasks_cours :interval "60s"
  "cat ~/.cache/eww_tasks_cours.json")


(defwidget todo_widget [tasks]
  (box
    :class "todo"
    :orientation "vertical"

    (label
      :class "title"
      :text "󰄬 Tasks")

    (for task in tasks
      (box
        :class "task"
        :orientation "horizontal"
        :halign "fill"
        :space-evenly false

        (label
          :halign "start"
          :text {task.done ? "✓ " : "○ "})

        (label
          :halign "start"
          :text {task.title})
      )
    )
  )
)

(defwindow todo-tasks
        :monitor 0
        :geometry ( geometry :x "20px"
                             :y "40px"
                             :width "420px"
                             :height "40%"
                             :anchor "top left")
        :stacking "bg"
        :focusable false
        :wm-ignore false

    (todo_widget :tasks tasks_cours )
)

(defwindow todo-cours
        :monitor 0
        :geometry ( geometry :x "20px"
                             :y "40px"
                             :width "420px"
                             :height "40%"
                             :anchor "bottom left")
        :stacking "bg"
        :focusable false
        :wm-ignore false

    (todo_widget :tasks tasks_cours)
)
