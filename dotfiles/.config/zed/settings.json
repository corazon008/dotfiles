// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "ssh_connections": [
    {
      "host": "jellyfin.lan",
      "username": "ubuntu",
      "args": [],
      "projects": [
        {
          "paths": ["/home/ubuntu"],
        },
      ],
    },
    {
      "host": "bronevez.uk",
      "username": "ubuntu",
      "args": [],
      "projects": [
        {
          "paths": ["/home/ubuntu"],
        },
      ],
    },
    {
      "host": "tdarr.lan",
      "username": "ubuntu",
      "args": [],
      "projects": [
        {
          "paths": ["/home/ubuntu"],
        },
      ],
    },
    {
      "host": "openwebui.lan",
      "username": "root",
      "args": [],
      "projects": [
        {
          "paths": ["/root"],
        },
      ],
    },
    {
      "host": "192.168.122.25",
      "username": "cachy",
      "args": [],
      "projects": [
        {
          "paths": ["/home/cachy/Projects/dotfiles/./"],
        },
      ],
    },
    {
      "host": "192.168.20.10",
      "username": "ubuntu",
      "args": [],
      "projects": [
        {
          "paths": ["/home/ubuntu"],
        },
      ],
    },
  ],
  "edit_predictions": {
    "copilot": {
      "enable_next_edit_suggestions": false,
    },
    "provider": "copilot",
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
    "github-copilot": {
      "type": "registry",
    },
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1",
    },
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "gpt-5-mini",
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-4.1",
      },
    ],
    "default_profile": "ask",
    "model_parameters": [],
  },
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "base_keymap": "JetBrains",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "JetBrains Dark",
  },

  "inlay_hints": {
    "show_other_hints": true,
    "show_parameter_hints": true,
    "show_type_hints": true,
    "show_value_hints": true,
  },

  // =========================
  // Editor Behavior
  // =========================
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "restore_on_startup": "last_session",
  "show_completions_on_input": true,

  "languages": {
    "Python": {
      "formatter": {
        "external": {
          "command": "black",
          "arguments": [
            "--stdin-filename",
            "{buffer_path}",
            "--line-length=80",
            "-",
          ],
        },
      },
      "language_servers": ["ty", "!basedpyright"],
    },
  },

  "terminal": {
    "detect_venv": "off",
  },

  "jupyter": {
    "enabled": true,
    "kernel_selections": {
      "python": "ipykernel",
    },
  },
}
